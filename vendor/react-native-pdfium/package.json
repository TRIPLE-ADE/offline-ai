{
  "name": "react-native-pdfium",
  "version": "0.1.3",
  "description": "as",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "common",
    "*.podspec",
    "react-native.config.js",
    "third-party/include",
    "third-party/android",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-pdfium-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorbertKlockiewicz/react-native-pdfium.git"
  },
  "author": "Norbert Klockiewicz <Nklockiewicz12@gmail.com> (https://github.com/NorbertKlockiewicz)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NorbertKlockiewicz/react-native-pdfium/issues"
  },
  "homepage": "https://github.com/NorbertKlockiewicz/react-native-pdfium#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native-community/cli": "15.0.0-alpha.2",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.0.0",
    "jest": "^29.7.0",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-builder-bob": "^0.30.2",
    "typescript": "~5.8.3"
  },
  "packageManager": "yarn@4.1.1",
  "babel": {
    "presets": [
      "module:metro-react-native-babel-preset"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module"
      ],
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "PdfiumSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.pdfium"
    }
  }
}
